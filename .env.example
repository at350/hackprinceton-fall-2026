# Copy to .env at the repo root. Only ANTHROPIC_API_KEY is required.

# Agent (agent/lucid/config.py)
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=                     # optional: traces in LangSmith, project "lucid"
# LUCID_MODEL=anthropic:claude-sonnet-5
# LUCID_REGION_MODEL=anthropic:claude-haiku-5-5

# Device bridge (agent/lucid/device), all optional
# LUCID_SERIAL_PORT=/dev/tty.usbmodem1101   # default: find the Arduino
# LUCID_DEVICE_PORT=2025                    # port the bridge serves on
# LUCID_DEVICE_URL=http://localhost:2025    # where the agent finds the bridge
# NEXT_PUBLIC_DEVICE_URL=http://localhost:2025   # where the dashboard finds it

# Hand-off over iMessage (optional; without these the pre-alert is simulated)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# LUCID_PHOTON_PREFIX="[Lucid test] "

# Voice call after 60 s of silence (optional)
CARTESIA_API_KEY=
